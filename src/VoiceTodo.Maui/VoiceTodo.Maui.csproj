<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>VoiceTodo.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>VoiceTodo</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.voicetodo.app</ApplicationId>
    <ApplicationIdGuid>f7d2e8b1-3c4a-4f9b-9d2e-1a2b3c4d5e6f</ApplicationIdGuid>

    <!-- 版本号（对外展示 / 安装包 versionName 与 versionCode）；README 与隐私说明引用此值 -->
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <!-- 外部 XamlCompiler 需要 genxbf(Windows SDK)；本机 VS18 内置 in-process 编译器不依赖它，交由 MSBuild 自动选择时机（不再强制外部）。 -->
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- Windows App SDK 自包含部署：随应用自带运行时，避免 unpackaged 场景下依赖系统安装的 Windows App Runtime（防止 CLASSNOTREG 崩溃）。 -->
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- MAUI -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- 语音识别 ASR：whisper.net（whisper.cpp 绑定，含 Android/iOS/Windows 原生运行时） -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- 本地通知 / 定时器（Nag Mode、Snooze、自定义铃声、按钮） -->
    <PackageReference Include="Plugin.LocalNotification" Version="13.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceTodo.Core\VoiceTodo.Core.csproj" />
  </ItemGroup>

  <!-- 应用图标与启动屏（MauiIcon/MauiSplashScreen→Android mipmap、Windows 资源） -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

  <!-- 模型目录：把 whisper.net 的 ASR ggml 模型放到此处（构建时打包进应用） -->
  <ItemGroup>
    <MauiAsset Include="Resources\Models\**\*.*" Condition="Exists('Resources\Models')" />
  </ItemGroup>

  <!--
    Windows 目标：MauiAsset 在 WinUI 输出目录下不会被拷贝到 app 内容里，
    导致 FileSystem.OpenAppPackageFileAsync（= BaseDirectory + 相对路径）找不到模型。
    这里在构建后显式把 Resources\Models 以同相对路径拷到 $(TargetDir)，保证解包/自包含运行都能读到。
  -->
  <ItemGroup>
    <WindowsModelAsset Include="Resources\Models\**\*.*"
                       Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and Exists('Resources\Models')" />
  </ItemGroup>
  <Target Name="CopyModelsToWindowsOutput"
          AfterTargets="Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Copy SourceFiles="@(WindowsModelAsset)"
          DestinationFiles="@(WindowsModelAsset->'$(TargetDir)Resources\Models\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
