<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceTodo.Maui.Pages.TextAddPage">

    <!-- 文字添加待办：输入防抖解析 → chips 展示识别结果 → 草稿行可改（06-text-add 设计稿） -->
    <Grid>

        <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,20" RowSpacing="12">

            <!-- 顶栏：X + 居中标题 -->
            <Grid ColumnDefinitions="44,*,44">
                <Border x:Name="CloseWrap" Style="{StaticResource IconCircle}">
                    <Button x:Name="CloseBtn" Style="{StaticResource GhostButton}" Padding="0" CornerRadius="22"
                            FontSize="18" Text="✕" Clicked="OnCloseClicked" />
                </Border>
                <Label x:Name="TitleLabel" Grid.Column="1" Style="{StaticResource BodyText}"
                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="12">

                    <!-- 输入卡 -->
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Editor x:Name="InputEditor" HeightRequest="96" BackgroundColor="Transparent"
                                TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextMuted}"
                                TextChanged="OnInputTextChanged" />
                    </Border>

                    <!-- 已识别 chips（无解析结果时整块隐藏） -->
                    <VerticalStackLayout x:Name="RecognizedSection" Spacing="8" IsVisible="False">
                        <Label x:Name="RecognizedHeaderLabel" Style="{StaticResource SectionHeader}" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="ChipsHost" Spacing="8" />
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- 草稿字段卡 -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout>
                            <Grid x:Name="ItemRow" ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="8">
                                <Label x:Name="ItemLabel" FontSize="15" TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="ItemValue" Grid.Column="1" Style="{StaticResource ValueText}"
                                       HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="›" FontSize="18" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditItem" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView Style="{StaticResource RowSeparator}" />
                            <Grid x:Name="TimeRow" ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="8">
                                <Label x:Name="TimeLabel" FontSize="15" TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="TimeValue" Grid.Column="1" Style="{StaticResource ValueText}"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Column="2" Text="›" FontSize="18" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditTime" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView Style="{StaticResource RowSeparator}" />
                            <Grid x:Name="RepeatRow" ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="8">
                                <Label x:Name="RepeatLabel" FontSize="15" TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="RepeatValue" Grid.Column="1" Style="{StaticResource ValueText}"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Column="2" Text="›" FontSize="18" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditRepeat" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="EditHintLabel" Style="{StaticResource AuxText}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="2" Style="{StaticResource PrimaryBtnWrap}">
                <Button x:Name="ConfirmBtn" Style="{StaticResource GhostButton}" TextColor="White"
                        Clicked="OnConfirmAdd" />
            </Border>
        </Grid>

        <!-- 覆盖层：事项 / 日期 / 时间 / 重复 -->
        <Grid x:Name="Overlay" IsVisible="False" BackgroundColor="#66000000">
            <Border Style="{StaticResource Card}" VerticalOptions="Center" HorizontalOptions="Center"
                    WidthRequest="320" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="OverlayTitle" Style="{StaticResource SectionHeader}" HorizontalOptions="Center" />
                    <Editor x:Name="OverlayEditor" IsVisible="False" HeightRequest="90"
                            BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" />
                    <DatePicker x:Name="OverlayDatePicker" IsVisible="False" DateSelected="OnOverlayDatePicked" />
                    <TimePicker x:Name="OverlayTimePicker" IsVisible="False" TimeSelected="OnOverlayTimePicked" />
                    <VerticalStackLayout x:Name="OverlayOptions" IsVisible="False" Spacing="4" />
                    <Border Style="{StaticResource PrimaryBtnWrap}">
                        <Button x:Name="OverlayOkBtn" Style="{StaticResource GhostButton}" TextColor="White"
                                Clicked="OnOverlayClose" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
